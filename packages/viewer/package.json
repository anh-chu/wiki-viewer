{
  "name": "@wiki-viewer/viewer",
  "version": "0.1.0",
  "description": "Standalone read-only file viewer for Markdown, source code, CSV, images, PDFs, media, HTML, and binary files",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && tailwindcss -i src/styles/index.css -o dist/styles.css --minify && cp src/styles/theme.css dist/theme.css && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/ssr-check.mjs && node scripts/verify.mjs && node scripts/xss-repro.mjs && node scripts/hostile-probe.mjs && node scripts/golden.mjs",
    "dev": "vite build --watch",
    "verify": "node scripts/ssr-check.mjs && node scripts/verify.mjs && node scripts/xss-repro.mjs && node scripts/hostile-probe.mjs && node scripts/golden.mjs",
    "prepublishOnly": "rm -rf dist && npm run build",
    "prepack": "node scripts/ssr-check.mjs && node scripts/verify.mjs && node scripts/xss-repro.mjs && node scripts/hostile-probe.mjs && node scripts/golden.mjs",
    "golden:update": "node scripts/golden.mjs --update",
    "prepare": "node scripts/ensure-built.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.525.0",
    "mermaid": "^11.14.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.3.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anh-chu/wiki-viewer.git",
    "directory": "packages/viewer"
  }
}
